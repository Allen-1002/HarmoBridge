<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004；Toast 通知与 DnsServiceRegister（mDNS 广播）都需要 Windows 10 1809+ -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 允许在 macOS / Linux 上交叉编译 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NotiBridge</AssemblyName>
    <RootNamespace>NotiBridge.Windows</RootNamespace>
    <ApplicationIcon>Assets\NotiBridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>NotiBridge</Product>
    <Company>NotiBridge</Company>
    <Description>把手机通知同步到 Windows</Description>
    <!-- WPF Fluent 主题（ThemeMode）仍标记为实验性 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NotiBridge.Core\NotiBridge.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <EmbeddedResource Include="Assets\NotiBridge.ico" LogicalName="NotiBridge.ico" />
    <!-- ESP32 固件（firmware/esp32/build_firmware.sh 生成） -->
    <EmbeddedResource Include="..\..\..\firmware\esp32\prebuilt\notibridge-esp32.bin" LogicalName="notibridge-esp32.bin"
                      Condition="Exists('..\..\..\firmware\esp32\prebuilt\notibridge-esp32.bin')" />
  </ItemGroup>
</Project>
