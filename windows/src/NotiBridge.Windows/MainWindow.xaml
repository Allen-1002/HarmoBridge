<Window x:Class="NotiBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NotiBridge.Windows"
        Title="NotiBridge" Width="980" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon.png">
    <Window.Resources>
        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Avatar" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="RecordTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Avatar}" Background="{Binding AvatarBrush}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{Binding AppName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </TextBlock>
                    <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Style="{StaticResource Hint}" TextWrapping="NoWrap" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" BorderThickness="1"
                        BorderBrush="{Binding ResultBrush}">
                    <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============ 首次启动引导 ============ -->
        <Grid x:Name="Onboarding" Visibility="Collapsed" Margin="40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/AppIcon.png" Width="44" Height="44" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ObTitle" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="ObStep" Style="{StaticResource Hint}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,24,0,16" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 1 欢迎 -->
                    <StackPanel x:Name="Ob0">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="把手机上的通知安全地同步到这台 Windows 电脑。数据只在你自己的设备之间加密传输，不经过任何服务器。" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Section}" Text="通知同步" Margin="0" />
                                <TextBlock Style="{StaticResource Hint}" Text="微信、短信、邮件等通知实时出现在 Windows 通知中心，手机上清除后电脑上也会消失。" Margin="0,2,0,10" />
                                <TextBlock Style="{StaticResource Section}" Text="验证码自动复制" Margin="0" />
                                <TextBlock Style="{StaticResource Hint}" Text="收到验证码短信，电脑上直接 Ctrl+V 粘贴；2 分钟后自动清除，不进入剪贴板历史。" Margin="0,2,0,10" />
                                <TextBlock Style="{StaticResource Section}" Text="多台设备" Margin="0" />
                                <TextBlock Style="{StaticResource Hint}" Text="一台电脑可以配对多台手机；一台手机也可以同时连接多台电脑（Windows 和 Mac 都可以）。" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Section}" Text="接下来需要你允许" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock><Run FontWeight="SemiBold" Text="通知" /><Run Text="  必需" Foreground="#E5484D" /></TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="用 Windows 通知中心显示手机通知。" Margin="0,2,0,10" />
                                <TextBlock><Run FontWeight="SemiBold" Text="网络访问（防火墙）" /><Run Text="  必需" Foreground="#E5484D" /></TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="手机在同一 Wi-Fi 下连接本机端口 47800。Windows 弹出防火墙提示时请勾选“专用网络”并允许。" Margin="0,2,0,10" />
                                <TextBlock><Run FontWeight="SemiBold" Text="蓝牙配对" /><Run Text="  按需" Foreground="#F59E0B" /></TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="仅鸿蒙手机需要：鸿蒙系统规定读取通知必须绑定一台已配对的蓝牙设备。如果手机还没有绑定任何电脑，可以把手机和这台电脑蓝牙配对。安卓手机不需要。" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- 使用方式 -->
                    <StackPanel x:Name="ObMode" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="之后可以在 设置 里更改。手机端也可以选择同样的方式。" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <RadioButton GroupName="UseMode" IsChecked="{Binding Esp32.UseSoftware}" FontWeight="SemiBold" Content="纯软件（推荐）" />
                                <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" FontSize="13"
                                           Text="同步通知、验证码自动复制，不需要任何额外硬件。不能接打电话。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <RadioButton GroupName="UseMode" IsChecked="{Binding Esp32.UseEsp32}" FontWeight="SemiBold" Content="使用 ESP32" />
                                <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" FontSize="13"
                                           Text="在上面的基础上，还可以在电脑上接听、拨打电话。需要一块 ESP32 模块插在电脑 USB 上，由 NotiBridge 检测并刷写固件。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- ESP32 -->
                    <StackPanel x:Name="ObEsp" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="用支持数据传输的 USB 线把 ESP32 模块连接到这台电脑，然后检测。ESP32 通话固件尚在开发中，目前可以先完成检测；也可以直接下一步，稍后在 设置 里完成。" />
                        <Border Style="{StaticResource Card}">
                            <local:Esp32Panel DataContext="{Binding Esp32}" />
                        </Border>
                    </StackPanel>
                    <!-- 2 通知 -->
                    <StackPanel x:Name="Ob1" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="点下面的按钮发送一条测试通知。如果右下角没有弹出，请在 设置 &gt; 系统 &gt; 通知 中打开 NotiBridge 的通知，并关闭“专注助手/勿扰”。" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="发送测试通知" Click="OnTestNotification" Margin="0,0,8,0" Padding="16,8" />
                            <Button Content="打开通知设置" Click="OnOpenNotificationSettings" Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                    <!-- 3 网络 -->
                    <StackPanel x:Name="Ob2" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="NotiBridge 已在本机开始监听。手机需要和电脑连接同一个 Wi-Fi（或同一局域网）。" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Listening}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Addresses}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13"
                                   Text="如果弹出了“Windows 安全中心”防火墙提示，请允许“专用网络”。当前网络被设为“公用网络”时，手机将无法连接，可在网络设置里改为“专用”。" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开网络设置" Click="OnOpenNetwork" Margin="0,0,8,0" Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                    <!-- 4 蓝牙 -->
                    <StackPanel x:Name="Ob3" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="安卓手机可以直接下一步。鸿蒙系统要求“读取通知”必须绑定一台已配对的蓝牙设备，但通知本身走局域网加密传输，平时不需要蓝牙连接。" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="• 手机已经绑定过其他电脑（例如 Mac）：直接下一步，不需要再配对蓝牙。" Margin="0,0,0,6" />
                                <TextBlock TextWrapping="Wrap" Text="• 还没有绑定：打开电脑的蓝牙设置 → 添加设备，在手机 设置 &gt; 蓝牙 中选择这台电脑完成配对，然后在手机 NotiBridge 里选择它。" />
                            </StackPanel>
                        </Border>
                        <Button Content="打开蓝牙设置" Click="OnOpenBluetooth" HorizontalAlignment="Left" Padding="16,8" />
                    </StackPanel>
                    <!-- 5 配对 -->
                    <StackPanel x:Name="Ob4" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="在手机 NotiBridge 里点“添加电脑”，选择这台电脑并输入下面的配对码。也可以跳过，稍后在“设备与配对”里配对。" />
                        <ContentControl x:Name="ObPairingHost" />
                    </StackPanel>
                    <!-- 6 完成 -->
                    <StackPanel x:Name="Ob5" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"
                                   Text="设置完成。关闭窗口后 NotiBridge 会留在任务栏右下角的托盘里继续工作。" />
                        <CheckBox Content="开机时自动启动（推荐）" IsChecked="{Binding AutoStartEnabled}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2">
                <Button x:Name="ObBack" Content="上一步" Click="OnObBack" HorizontalAlignment="Left" Padding="20,8" />
                <Button x:Name="ObNext" Content="下一步" Click="OnObNext" HorizontalAlignment="Right" Padding="24,8"
                        Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </Grid>

        <!-- ============ 主界面 ============ -->
        <Grid x:Name="Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="12,16,8,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
                    <Image Source="Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,10,0" />
                    <TextBlock Text="NotiBridge" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="Nav" SelectionChanged="OnNav" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" /><TextBlock Text="概览" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" /><TextBlock Text="通知记录" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8EA;" /><TextBlock Text="设备与配对" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" /><TextBlock Text="过滤规则" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA37;" /><TextBlock Text="日志" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /><TextBlock Text="设置" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1">
                <!-- 概览 -->
                <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,28,24">
                        <Border CornerRadius="12" Padding="22" Margin="0,0,0,14" Background="{StaticResource HeroBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="Assets/AppIcon.png" Width="60" Height="60" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="{Binding SubHeadline}" Foreground="#DDFFFFFF" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Listening}" Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="同步" IsChecked="{Binding SyncOn}" Foreground="White"
                                          VerticalAlignment="Center" IsEnabled="{Binding HasDevices}" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,2">
                            <Border Style="{StaticResource Card}" Margin="0,0,8,12">
                                <StackPanel><TextBlock Style="{StaticResource StatValue}" Text="{Binding TodayShown}" Foreground="#3B82F6" /><TextBlock Style="{StaticResource Hint}" Text="今日已显示" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,12">
                                <StackPanel><TextBlock Style="{StaticResource StatValue}" Text="{Binding TodayOtp}" Foreground="#06B6D4" /><TextBlock Style="{StaticResource Hint}" Text="验证码已复制" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,4,12">
                                <StackPanel><TextBlock Style="{StaticResource StatValue}" Text="{Binding TodayFiltered}" Foreground="#F59E0B" /><TextBlock Style="{StaticResource Hint}" Text="已过滤" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="8,0,0,12">
                                <StackPanel><TextBlock Style="{StaticResource StatValue}" Text="{Binding Devices.Count}" Foreground="#8B5CF6" /><TextBlock Style="{StaticResource Hint}" Text="已配对手机" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasLastOtp, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="再次复制" Click="OnCopyOtp" />
                                <TextBlock VerticalAlignment="Center"><Run Text="最近的验证码：" /><Run Text="{Binding LastOtpText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="快捷操作" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="配对新手机" Click="OnPairFromOverview" Margin="0,0,8,8" Padding="16,8" Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="打开蓝牙设置" Click="OnOpenBluetooth" Margin="0,0,8,8" Padding="16,8" />
                            <Button Content="测试 Windows 通知" Click="OnTestNotification" Margin="0,0,8,8" Padding="16,8" />
                        </WrapPanel>

                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="查看全部" Click="OnShowRecords" />
                            <TextBlock Style="{StaticResource Section}" Text="最近通知" />
                        </DockPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <TextBlock Text="还没有收到手机通知" Style="{StaticResource Hint}" FontSize="13" x:Name="NoRecordsHint" />
                                <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource RecordTemplate}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 通知记录 -->
                <DockPanel x:Name="Page1" Visibility="Collapsed" Margin="24,20,28,24">
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <CheckBox Content="在列表中显示内容" IsChecked="{Binding ShowContentInList}" Margin="0,0,12,0" />
                            <Button Content="清空" Click="OnClearRecords" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="通知记录" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,-8,0,12"
                               Text="只保存在内存里，退出后清空。右键某条记录可以把该应用加入黑名单。" />
                    <ListBox x:Name="RecordList" ItemsSource="{Binding Records}" ItemTemplate="{StaticResource RecordTemplate}"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="不再同步这个应用（加入黑名单）" Click="OnBlockApp" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>

                <!-- 设备与配对 -->
                <ScrollViewer x:Name="Page2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,28,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="设备与配对" />
                        <ContentControl x:Name="PairingHost">
                            <!-- 配对面板（引导页与此处共用，由代码移动） -->
                            <Border x:Name="PairingPanel" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding IsPairing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="在手机上输入配对码" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PairingPin}" FontSize="44" FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                                                   Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding PairingRemaining}" Style="{StaticResource Hint}" />
                                        <Border Visibility="{Binding HasSas, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0" Padding="12"
                                                CornerRadius="6" BorderThickness="1" BorderBrush="#F59E0B">
                                            <StackPanel>
                                                <TextBlock Text="请核对校验码" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PairingSas}" FontSize="30" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Margin="0,4" />
                                                <TextBlock Style="{StaticResource Hint}" Text="确认与手机上显示的校验码完全一致后，在手机上点“一致，确认”。不一致说明连接可能被冒充，请取消。" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="取消配对" Click="OnCancelPairing" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="PairIdle">
                                        <TextBlock Text="配对新手机" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                                   Text="点下面的按钮生成 6 位配对码（2 分钟有效，输错 3 次作废）。在手机 NotiBridge 中选择“添加电脑”，自动发现这台电脑后输入配对码；找不到时手动填写下面的地址。" />
                                        <TextBlock Margin="0,0,0,10"><Run Text="本机地址：" /><Run Text="{Binding PrimaryAddress, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  端口：" /><Run Text="{Binding Port, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                        <Button Content="生成配对码" Click="OnOpenPairing" HorizontalAlignment="Left" Padding="16,8"
                                                Style="{DynamicResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ContentControl>

                        <TextBlock Style="{StaticResource Section}" Text="已配对的手机" />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <TextBlock x:Name="NoDevicesHint" Text="还没有配对手机" Style="{StaticResource Hint}" FontSize="13" />
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Avatar}" Background="{Binding AvatarBrush}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="改名" Click="OnRename" Tag="{Binding}" Margin="0,0,8,0" />
                                                    <Button Content="取消配对" Click="OnUnpair" Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="手机 App 不在前台时，通知由系统按需拉起的订阅扩展连接转发，所以“待命”不等于收不到通知。取消配对会同步到手机：手机在线时立即从手机上删除这台电脑，不在线时下次连接时自动删除。" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 过滤规则 -->
                <ScrollViewer x:Name="Page3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,28,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="过滤规则" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Content="同步通知（关闭即暂停同步）" IsChecked="{Binding SyncOn}" />
                                <CheckBox Content="拦截疑似敏感通知（验证码、银行、支付等关键词）" IsChecked="{Binding BlockSensitive}" Margin="0,8,0,0" />
                                <CheckBox Content="验证码自动复制到剪贴板" IsChecked="{Binding CopyOtp}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="这三个开关会和所有已连接的手机双向同步（以最后修改的为准）。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <RadioButton Content="同步所有应用（黑名单中的除外）" IsChecked="True" x:Name="ModeAll" Checked="OnModeChanged" />
                                <RadioButton Content="只同步白名单中的应用" x:Name="ModeWhite" Checked="OnModeChanged" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Section}" Text="黑名单（包名，每行一个）" />
                                <TextBox x:Name="BlacklistBox" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Section}" Text="白名单（包名，每行一个）" />
                                <TextBox x:Name="WhitelistBox" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Section}" Text="敏感关键词（每行一个）" />
                        <TextBox x:Name="KeywordsBox" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存规则" Click="OnSaveFilter" Padding="16,8" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="恢复默认关键词" Click="OnResetKeywords" Padding="16,8" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="包名可以在“通知记录”里右键某条记录直接加入黑名单。手机端也有自己的应用过滤，两边都放行才会显示。" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 日志 -->
                <DockPanel x:Name="Page4" Visibility="Collapsed" Margin="24,20,28,24">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="日志" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,-8,0,12" Text="日志不记录通知标题和正文。" />
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
                </DockPanel>

                <!-- 设置 -->
                <ScrollViewer x:Name="Page5" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,28,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Content="开机时自动启动" IsChecked="{Binding AutoStartEnabled}" />
                                <CheckBox Content="在通知记录中显示内容" IsChecked="{Binding ShowContentInList}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ESP32 通话模块" FontWeight="SemiBold" />
                                <RadioButton GroupName="UseModeSettings" IsChecked="{Binding Esp32.UseSoftware}" Content="纯软件：同步通知和验证码，不能接打电话" Margin="0,8,0,0" />
                                <RadioButton GroupName="UseModeSettings" IsChecked="{Binding Esp32.UseEsp32}" Content="使用 ESP32：额外支持在电脑上接打电话（固件开发中）" Margin="0,4,0,8" />
                                <local:Esp32Panel DataContext="{Binding Esp32}"
                                                  Visibility="{Binding Esp32.UseEsp32, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="网络" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Listening}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Addresses}" Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                <TextBlock Style="{StaticResource Hint}" Text="手机连不上时：确认两者在同一 Wi-Fi，Windows 防火墙已允许 NotiBridge 访问“专用网络”，并且当前网络不是“公用网络”。" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="网络设置" Click="OnOpenNetwork" Margin="0,0,8,0" />
                                    <Button Content="通知设置" Click="OnOpenNotificationSettings" Margin="0,0,8,0" />
                                    <Button Content="蓝牙设置" Click="OnOpenBluetooth" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel DataContext="{Binding Updater}">
                                <TextBlock Text="软件更新" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0">
                                    <Run Text="当前版本 " /><Run Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                    <Run Text="  ·  最新版本 " /><Run Text="{Binding LatestVersionText, Mode=OneWay}" />
                                </TextBlock>
                                <CheckBox Content="自动检查更新" IsChecked="{Binding AutoCheck}" Margin="0,8,0,0" />
                                <CheckBox Content="自动下载并安装" IsChecked="{Binding AutoInstall}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,0"
                                             Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="检查更新" Click="OnCheckUpdate" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                                    <Button Content="{Binding InstallButtonText}" Click="OnInstallUpdate" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                                            Style="{DynamicResource AccentButtonStyle}"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="查看发布页" Click="OnOpenReleasePage"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="点“检查更新”只检查，不会下载；发现新版后可以先下载，校验 SHA256 和版本号后再选择重启安装。打开“自动下载并安装”时，后台检查（启动 30 秒后一次，之后每 6 小时一次）发现新版会自动下载并重启安装；正在配对手机时不会安装。" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="关于" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,4,0,4" />
                                <TextBlock Text="{Binding InstallText, Mode=OneTime}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="安装到这台电脑" Click="OnInstall" Margin="0,0,8,0"
                                            Visibility="{Binding IsPortable, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="清除所有数据并重新开始" Click="OnResetAllData" Margin="0,0,8,0" />
                                    <Button Content="卸载 NotiBridge" Click="OnUninstall" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="重新运行首次引导" Click="OnRestartOnboarding" Margin="0,0,8,0" />
                                    <Button Content="项目主页" Click="OnHomepage" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
