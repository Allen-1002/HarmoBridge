<UserControl x:Class="NotiBridge.Windows.Esp32Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = Esp32Manager。引导页和设置页共用。 -->
    <StackPanel>
        <WrapPanel>
            <Button x:Name="ScanButton" Content="检测已连接的 ESP32" Click="OnScan" Padding="16,8" Margin="0,0,10,8" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </WrapPanel>
        <StackPanel Visibility="{Binding HasPorts, Converter={StaticResource BoolToVis}}">
            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding Selected}" MinWidth="320" HorizontalAlignment="Left" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="检测固件" Click="OnCheck" IsEnabled="{Binding NotBusy}" Margin="0,0,8,0" />
                <Button Content="刷写固件" Click="OnFlash" IsEnabled="{Binding NotBusy}" />
            </StackPanel>
            <TextBlock Text="{Binding FirmwareText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding FirmwareMissing, Converter={StaticResource BoolToVis}}">
                <Button Content="重新刷写固件" Click="OnFlash" Margin="0,0,8,0" />
                <Button Content="不刷写，稍后再说" Click="OnSkip" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="已经刷写过固件的模块，直接点“检测固件”即可；检测不通过时可以重新刷写或补齐固件，也可以先跳过。" />
    </StackPanel>
</UserControl>
