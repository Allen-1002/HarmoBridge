<UserControl x:Class="NotiBridge.Windows.Esp32Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = Esp32Manager。ESP32 模块页和首次引导共用。
         状态卡：板子 → 固件 → iPhone → 通话，每一行只在需要处理时给出按钮。 -->
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="64" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- 板子 -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="BoardMark" Width="22" FontWeight="Bold" />
            <TextBlock Style="{StaticResource RowTitle}" Text="板子" />
            <StackPanel>
                <TextBlock x:Name="BoardText" Style="{StaticResource RowHint}" />
                <ComboBox x:Name="PortBox" ItemsSource="{Binding Ports}" SelectedItem="{Binding Selected}" IsEnabled="{Binding NotBusy}"
                          MinWidth="320" HorizontalAlignment="Left" Margin="0,6,0,0" SelectionChanged="OnPortChanged" />
            </StackPanel>
        </DockPanel>
        <!-- 固件 -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="FirmwareMark" Width="22" FontWeight="Bold" />
            <TextBlock Style="{StaticResource RowTitle}" Text="固件" />
            <StackPanel>
                <TextBlock Text="{Binding FirmwareText}" Style="{StaticResource RowHint}" />
                <ProgressBar Value="{Binding FlashProgress, Mode=OneWay}" Maximum="1" Height="6" MaxWidth="420" HorizontalAlignment="Stretch"
                             Margin="0,6,0,0" Visibility="{Binding Flashing, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding NeedsFirmwareUpdate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UpdateFirmwareText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="更新固件" Click="OnFlash" IsEnabled="{Binding CanFlash}" />
                </StackPanel>
                <StackPanel x:Name="FlashRow" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckButton" Content="检测固件" Click="OnCheck" IsEnabled="{Binding NotBusy}" Margin="0,0,8,0" />
                        <Button Content="刷写固件" Click="OnFlash" IsEnabled="{Binding CanFlash}" Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowHint}" FontSize="12" Margin="0,6,0,0"
                               Text="第一次刷写某块板子前会先自动备份板子上原有的固件（约 1~3 分钟），之后可以在“高级”里一键还原。" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <!-- iPhone -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="IphoneMark" Width="22" FontWeight="Bold" />
            <TextBlock Style="{StaticResource RowTitle}" Text="iPhone" />
            <StackPanel>
                <TextBlock x:Name="IphoneText" Style="{StaticResource RowHint}" />
                <ItemsControl x:Name="IphoneList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddIphoneButton" Content="添加 iPhone" Click="OnAddIphone" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>
        <!-- 通话 -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock x:Name="CallMark" Width="22" FontWeight="Bold" />
            <TextBlock Style="{StaticResource RowTitle}" Text="通话" />
            <StackPanel>
                <TextBlock x:Name="CallText" Style="{StaticResource RowHint}" />
                <TextBlock x:Name="PairCodeText" TextWrapping="Wrap" Margin="0,4,0,0" />
                <!-- 当前通话 -->
                <StackPanel x:Name="CallActive" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="CallLabel" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="AnswerButton" Content="接听" Click="OnAnswer" Margin="0,0,8,0" />
                    <Button x:Name="HangUpButton" Content="挂断" Click="OnHangUp" />
                </StackPanel>
                <!-- 拨号 -->
                <StackPanel x:Name="DialRow" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="DialBox" Width="180" Margin="0,0,8,0" KeyDown="OnDialKey" />
                    <Button Content="拨打" Click="OnDial" Margin="0,0,8,0" />
                    <Button Content="重拨" Click="OnRedial" />
                </StackPanel>
                <ItemsControl x:Name="PhoneList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <Button Content="删除" Tag="{Binding Id}" Click="OnForgetPhone" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <Button Content="{Binding PreferText}" Tag="{Binding Id}" Click="OnPreferPhone" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Visibility="{Binding CanPrefer, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{Binding ConnectText}" Tag="{Binding Id}" Click="OnConnectPhone" DockPanel.Dock="Right"
                                        Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="PairPhoneRow" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="PairPhoneButton" Content="配对手机" Click="OnPairPhone" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource RowHint}" VerticalAlignment="Center" FontSize="12"
                               Text="然后在手机「设置 › 蓝牙」里点“NotiBridge 通话”。安卓、鸿蒙、iPhone 都可以；同一时间只能有一台手机连着通话。" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <!-- 高级 -->
        <Expander Header="高级" Margin="0,4,0,0">
            <StackPanel Margin="0,8,0,0">
                <WrapPanel>
                    <Button Content="重新检测" Click="OnScan" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8" />
                    <Button Content="重新刷写固件" Click="OnFlash" IsEnabled="{Binding CanFlash}" Margin="0,0,8,8" />
                    <Button x:Name="ForgetAllButton" Content="删除全部 iPhone 配对" Click="OnForget" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                    <Button Content="还原原固件" Click="OnRestore" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"
                            Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}" />
                    <Button Content="打开备份文件夹" Click="OnReveal" Margin="0,0,8,8" />
                    <TextBlock x:Name="BackupInfo" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
