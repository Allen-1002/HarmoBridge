<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NotiBridge.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- X25519 与 Ed25519：.NET 自带的 ECDiffieHellman / ECDsa 不支持 Curve25519 -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NotiBridge.Core.Tests" />
  </ItemGroup>
</Project>
